# Required for eBook checkout + instant download
# Use your secret key from Stripe Dashboard → Developers → API keys
# LOCAL: sk_test_... only (in .env.local, never committed)
# PRODUCTION (Vercel): sk_live_... only — if a live key was ever exposed, roll it in Stripe and update Vercel.
STRIPE_SECRET_KEY=sk_test_...

# Local test-mode price IDs only (never set these on Vercel).
# Production always uses stripePriceIdEbook from src/data/books.json.
# STRIPE_TEST_PRICE_BOOK_ONE=price_...
# STRIPE_TEST_PRICE_BOOK_TWO=price_...
# STRIPE_TEST_PRICE_BOOK_THREE=price_...

# Neon/Postgres connection string (server-side only). Source of truth for
# eBook purchase and entitlement records. Never expose to the browser.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Stripe webhook signing secret from Developers → Webhooks → your endpoint.
# Local: Stripe CLI `stripe listen --forward-to localhost:3000/api/webhooks/stripe`
# Production: the signing secret for https://twilight-feather.com/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_...

# Public site URL (no trailing slash). Used for Stripe redirects and blog link previews when shared on social.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Blog admin (/admin): one or more usernames with passwords, plus a session secret.
# Usernames are case-insensitive. Replace placeholder passwords before going live.
# If ADMIN_SESSION_SECRET was exposed, generate a new one and redeploy (invalidates admin logins).
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_USERS={"omari":"placeholder-omari","dale":"placeholder-dale"}
ADMIN_SESSION_SECRET=replace-with-long-random-string

# Blog posts created in /admin and email list signups are stored in
# private/*.json locally. On Vercel, the same stores use your Blob token
# (often already set for eBooks). Without BLOB_READ_WRITE_TOKEN on Vercel,
# email signup can fail to persist.
# BLOB_READ_WRITE_TOKEN=

# Email list confirmations + Resend Contacts for newsletters.
# 1) Create a free Resend account → API Keys (or connect via Vercel integration)
# 2) Verify twilight-feather.com and set RESEND_FROM_EMAIL
RESEND_API_KEY=re_...
# Important: use a Full Access API key from Resend → API Keys.
# The Vercel integration key is often sending-only and can send emails
# but cannot create Contacts / add Segments.
RESEND_FROM_EMAIL="Twilight Feather <hello@twilight-feather.com>"
# Optional: Segment ID for newsletter signups (create a Segment in Resend).
# RESEND_NEWSLETTER_ID=...
# Optional aliases also supported: RESEND_SEGMENT_ID, RESEND_AUDIENCE_ID (legacy)
# Optional: Topic for preference management.
# RESEND_TOPIC_ID=...

# Promotion code shown after email signup (also auto-created in Stripe if missing).
# Buyers enter it on Stripe Checkout for eBook purchases on this site.
# NEWSLETTER_DISCOUNT_CODE=TWILIGHTFEATHER10

# In src/data/books.json use stripePriceIdEbook = a Price ID (starts with price_),
# not a Product ID (prod_). Copy it from the product’s Pricing section in Stripe.

# Private Vercel Blob (required for eBook download). After Stripe verifies payment,
# the server signs a short-lived GET URL for the catalog pathname
# (Sickle Cell.pdf / Word Search.pdf / Asthma.pdf). Do not store dashboard
# signed URLs in env. Do not set EBOOK_BLOB_URLS.
# BLOB_READ_WRITE_TOKEN=
