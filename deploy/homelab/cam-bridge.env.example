# Copy to /etc/medimori/cam-bridge.env (chmod 600). All flags default off.

NODE_ENV=production
CENTRAL_AGENT_MANAGER_CURSOR_BRIDGE_RUNNER_ENABLED=false
CENTRAL_AGENT_MANAGER_CURSOR_BRIDGE_ENABLED=false
CURSOR_BRIDGE_RUNNER_OFFLINE_FAKE_TRANSPORT=false

# Consumer HTTP to app host (not Cursor API)
CURSOR_BRIDGE_CONSUMER_BASE_URL=https://staging.example.com
CENTRAL_AGENT_MANAGER_AGENT_BEARERS_JSON=

# Runner identity and local control files
CURSOR_BRIDGE_RUNNER_ID=cursor-bridge-homelab
CURSOR_BRIDGE_RUNNER_LOCK_FILE=/var/lib/medimori/cursor-bridge-runner.lock.json
CURSOR_BRIDGE_RUNNER_EMERGENCY_STOP_FILE=/var/lib/medimori/cursor-bridge-runner.emergency-stop
CURSOR_BRIDGE_RUNNER_BUDGET_FILE=/var/lib/medimori/cursor-bridge-runner.budget.json
CURSOR_BRIDGE_RUNNER_DAILY_CREATE_BUDGET=24
CURSOR_BRIDGE_RUNNER_HOURLY_CYCLE_LIMIT=60

# CURSOR_API_KEY=   # Phase 5d only — leave unset until authorized
